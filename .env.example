# Copy to .env (gitignored) and fill in. Never commit .env.

# Nominatim usage policy asks for an identifying User-Agent with a contact.
NOMINATIM_USER_AGENT=

# LLM narration (all optional). LLM_PROVIDER=none gives template-only advice.
LLM_PROVIDER=none            # gemini | openrouter | none
LLM_API_KEY=
# Gemini (Google AI Studio key):
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=                   # a current Gemini Flash / Flash-Lite model ID, copied from AI Studio
# OpenRouter instead:
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=                 # one :free model ID from openrouter.ai/models
# LLM_FALLBACK_MODELS=       # 2 to 3 more :free IDs, comma-separated
# Optional: how much the model "thinks" (default none for gemini, unset otherwise)
# LLM_REASONING_EFFORT=
