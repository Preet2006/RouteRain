# Copy to .env (gitignored) and fill in. Never commit .env.
NOMINATIM_USER_AGENT=RouteRain-Research-Project/1.0

# Which provider the backend uses: gemini | openrouter | none (none = template advice only)
LLM_PROVIDER=none
GEMINI_API_KEY=
OPENROUTER_API_KEY=
# Models for the active provider. Run: python -m src.narrate --list-models
LLM_MODEL=
LLM_FALLBACK_MODELS=
# Optional overrides: LLM_BASE_URL (defaults per provider), LLM_REASONING_EFFORT (gemini default: none)
