{
  "name": "routerain-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:contract": "node --experimental-strip-types --no-warnings scripts/check-contract.mjs",
    "check:markers": "node --experimental-strip-types --no-warnings scripts/check-markers.mjs",
    "check:browser": "node scripts/browser-check.mjs",
    "check:cards": "node --experimental-strip-types --no-warnings scripts/check-cards.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.108.2",
    "leaflet": "1.9.4",
    "maplibre-gl": "^6.19.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-leaflet": "4.2.1",
    "react-router-dom": "^6.30.6",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/leaflet": "1.9.16",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "6.2.1",
    "axe-core": "^4.14.1",
    "jsdom": "^29.1.1",
    "puppeteer-core": "^25.18.1",
    "typescript": "5.6.3",
    "vite": "8.3.5",
    "vitest": "^5.1.1"
  }
}
